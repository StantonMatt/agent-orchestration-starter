#!/usr/bin/env python3
"""Run a finite job with shared slots, enough free RAM and low memory pressure.

HEAVY_SLOTS sets the slot count (default 4; positive integer).
HEAVY_MIN_FREE_GIB sets the minimum available RAM (default 4; nonnegative).
Use consistent limits for jobs sharing ~/.cache/heavy-slots.
HEAVY_ALLOW_DUPLICATE=1 allows identical queued or running commands; otherwise
such duplicates exit 75. Unavailable dedupe locks skip duplicate detection.
Use this for finite jobs, not long-running servers or watchers.
"""

import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import time

SLOT_COUNT = 4
MIN_AVAILABLE_BYTES = 4 * 1024**3
MAX_SOME_AVG10 = 10.0
MAX_FULL_AVG10 = 2.0
REMINDER_SECONDS = 60
DUPLICATE_EXIT = 75
DEDUPE_MAX_AGE = 24 * 60 * 60
SLOTS_DIR = Path.home() / ".cache" / "heavy-slots"
MEMINFO_PATH = Path("/proc/meminfo")
PRESSURE_PATH = Path("/proc/pressure/memory")


def try_lock(handle):
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def command_lock_name(cwd, command):
    """Hash an unambiguous encoding of the resolved cwd and exact argv."""
    identity = json.dumps([str(cwd), command], ensure_ascii=True).encode()
    return hashlib.sha256(identity).hexdigest() + ".lock"


def open_dedupe_lock(path):
    """Provision without truncating, accepting existing read-only locks.

    Unbuffered, so a failed advisory metadata write fails at once (and is
    swallowed) instead of being retried by close() during cleanup.
    """
    try:
        return open(path, "r+b", buffering=0)
    except FileNotFoundError:
        try:
            return open(path, "x+b", buffering=0)
        except FileExistsError:
            return open_dedupe_lock(path)
    except OSError:
        return open(path, "rb")


def read_command_metadata(handle):
    try:
        handle.seek(0)
        metadata = json.loads(handle.read(16384))
        return metadata if isinstance(metadata, dict) else {}
    except (OSError, ValueError, UnicodeError):
        return {}


def write_command_metadata(handle, cwd, command, started, state):
    if not handle.writable():
        return
    try:
        handle.seek(0)
        # Never persist argv: commands may carry secrets, and detection uses the hash.
        handle.write(json.dumps(dict(pid=os.getpid(), started=started,
                                    cwd=str(cwd), state=state)).encode())
        handle.truncate()
        handle.flush()
    except OSError:
        pass  # Metadata never determines whether a command is a duplicate.


def clean_command_locks(directory, current):
    """Caller holds cleanup.lock, serializing cleanup with every new claim.

    Never unlink a held inode, or an opener could lock its replacement while
    the original job still runs. The guard also prevents a new claimant from
    opening an unlocked inode just before we remove it.
    """
    cutoff = time.time() - DEDUPE_MAX_AGE
    try:
        for path in directory.glob("*.lock"):
            if path.name in ("cleanup.lock", current):
                continue
            try:
                if path.stat().st_mtime >= cutoff:
                    continue
                with open(path, "rb") as handle:
                    if try_lock(handle):
                        path.unlink()
            except OSError:
                pass
    except OSError:
        pass


def claim_command(cwd, command, started):
    """Return (held lock, None), (None, duplicate metadata), or skip on error."""
    if os.environ.get("HEAVY_ALLOW_DUPLICATE") == "1":
        return None, None
    handle = None
    try:
        directory = SLOTS_DIR / "dedupe"
        if not directory.is_dir():
            directory.mkdir(exist_ok=True)
        name = command_lock_name(cwd, command)
        with open_dedupe_lock(directory / "cleanup.lock") as guard:
            fcntl.flock(guard, fcntl.LOCK_EX)
            clean_command_locks(directory, name)
            handle = open_dedupe_lock(directory / name)
            if not try_lock(handle):
                metadata = read_command_metadata(handle)
                handle.close()
                return None, metadata
            write_command_metadata(handle, cwd, command, started, "queued")
        return handle, None
    except OSError:
        if handle is not None:
            handle.close()
        return None, None


def available_memory():
    if sys.platform == "darwin":
        try:
            report = subprocess.check_output(["/usr/bin/memory_pressure", "-Q"],
                                             text=True, timeout=2)
            percent = next(float(line.split(":", 1)[1].strip().rstrip("%"))
                           for line in report.splitlines()
                           if line.startswith("System-wide memory free percentage:"))
            total = int(subprocess.check_output(["/usr/sbin/sysctl", "-n", "hw.memsize"],
                                                text=True, timeout=2))
            if not 0 <= percent <= 100 or total <= 0:
                raise ValueError("invalid memory reading")
            return total * percent / 100
        except (OSError, subprocess.SubprocessError, ValueError, StopIteration):
            return None
    try:
        for line in MEMINFO_PATH.read_text().splitlines():
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return None


def memory_pressure():
    if sys.platform == "darwin":
        try:
            level = int(subprocess.check_output(
                ["/usr/sbin/sysctl", "-n", "kern.memorystatus_vm_pressure_level"],
                text=True, timeout=2))
            # macOS levels: normal=1, warning=2, critical=4. Normalize only
            # for admission; these are not Linux PSI measurements.
            return (0., 0.) if level == 1 else (100., 100.) if level in (2, 4) else None
        except (OSError, subprocess.SubprocessError, ValueError):
            return None
    try:
        averages = {}
        for line in PRESSURE_PATH.read_text().splitlines():
            fields = line.split()
            if fields and fields[0] in ("some", "full"):
                values = dict(field.split("=", 1) for field in fields[1:])
                averages[fields[0]] = float(values["avg10"])
        pressure = averages["some"], averages["full"]
        if all(math.isfinite(value) and value >= 0 for value in pressure):
            return pressure
    except (OSError, ValueError, KeyError):
        pass
    return None


def provision_locks(slot_count):
    """Create missing locks exclusively; never replace a held lock inode."""
    SLOTS_DIR.mkdir(parents=True, exist_ok=True)
    names = [f"slot-{i}.lock" for i in range(slot_count)] + ["admission.lock"]
    for name in names:
        path = SLOTS_DIR / name
        if not path.exists():
            try:
                with open(path, "xb"):
                    pass
            except FileExistsError:
                pass


def configured_limits():
    try:
        slot_count = int(os.environ.get("HEAVY_SLOTS", str(SLOT_COUNT)))
        if slot_count < 1:
            raise ValueError
    except ValueError:
        raise ValueError("HEAVY_SLOTS must be a positive integer") from None
    try:
        min_free_gib = float(os.environ.get(
            "HEAVY_MIN_FREE_GIB", str(MIN_AVAILABLE_BYTES / 1024**3)))
        if not math.isfinite(min_free_gib) or min_free_gib < 0:
            raise ValueError
    except ValueError:
        raise ValueError("HEAVY_MIN_FREE_GIB must be a finite nonnegative number") from None
    return slot_count, min_free_gib


def main():
    try:
        # Keep queued jobs identifiable until exec replaces this process.
        Path("/proc/self/comm").write_text("heavy")
    except OSError:
        pass
    command = sys.argv[1:]
    if command[:1] == ["--"]:
        command = command[1:]
    if not command or command == ["--help"]:
        print("Usage: heavy [--] <command> [args...]\n"
              "HEAVY_SLOTS: shared slots (default 4; positive integer)\n"
              "HEAVY_MIN_FREE_GIB: minimum available RAM (default 4; nonnegative)\n"
              "HEAVY_ALLOW_DUPLICATE=1: allow an identical queued/running command\n"
              "Use consistent limits for jobs sharing ~/.cache/heavy-slots.",
              file=sys.stderr)
        return 0 if command else 2
    handles = []
    try:
        slot_count, min_free_gib = configured_limits()
        provision_locks(slot_count)
        cwd = Path(os.getcwd()).resolve()
        started = time.strftime("%H:%M:%S")
        dedupe, duplicate = claim_command(cwd, command, started)
        if duplicate is not None:
            state = "queued" if duplicate.get("state") == "queued" else "running"
            print(f"heavy: identical command already {state} "
                  f"(pid {duplicate.get('pid', 'unknown')}, "
                  f"started {duplicate.get('started', 'unknown')}) in {cwd}; "
                  "not starting a duplicate. Set HEAVY_ALLOW_DUPLICATE=1 to override.",
                  file=sys.stderr)
            return DUPLICATE_EXIT
        if dedupe is not None:
            handles.append(dedupe)

        def open_lock(name):
            handle = open(SLOTS_DIR / name, "rb")
            handles.append(handle)
            return handle

        slots = [open_lock(f"slot-{index}.lock") for index in range(slot_count)]
        admission = open_lock("admission.lock")
        next_reminder = 0.0
        warned_memory = False
        warned_pressure = False

        def memory_blockers():
            nonlocal warned_memory, warned_pressure
            available = available_memory()
            pressure = memory_pressure()
            blockers = []
            if available is None and not warned_memory:
                print("[heavy] cannot read available memory; skipping RAM check",
                      file=sys.stderr, flush=True)
                warned_memory = True
            if pressure is None and not warned_pressure:
                print("[heavy] cannot read memory pressure; skipping pressure check",
                      file=sys.stderr, flush=True)
                warned_pressure = True
            if available is not None and available < min_free_gib * 1024**3:
                blockers.append(f"RAM below {min_free_gib:g} GiB "
                                f"({available / 1024**3:.1f} GiB available)")
            if pressure is not None and (pressure[0] >= MAX_SOME_AVG10
                                         or pressure[1] >= MAX_FULL_AVG10):
                blockers.append("macOS memory pressure (warning or critical)" if sys.platform == "darwin"
                                else f"PSI (some avg10={pressure[0]:.2f}, full avg10={pressure[1]:.2f})")
            return blockers

        while True:
            selected = None
            # Serialize memory checks and slot acquisition. Release before waiting.
            fcntl.flock(admission, fcntl.LOCK_EX)
            try:
                blockers = memory_blockers()
                if not blockers:
                    for handle in slots:
                        if try_lock(handle):
                            selected = handle
                            break
                    if selected is None:
                        blockers.append("slots full (no slot available)")
                    else:
                        blockers = memory_blockers()
                        if blockers:
                            fcntl.flock(selected, fcntl.LOCK_UN)
                            selected = None
            finally:
                fcntl.flock(admission, fcntl.LOCK_UN)

            if selected is not None:
                if dedupe is not None:
                    write_command_metadata(dedupe, cwd, command, started, "running")
                for handle in handles:
                    if handle is selected or handle is dedupe:
                        os.set_inheritable(handle.fileno(), True)
                    else:
                        handle.close()
                os.execvp(command[0], command)
            now = time.monotonic()
            if now >= next_reminder:
                print("[heavy] waiting: " + "; ".join(blockers), file=sys.stderr, flush=True)
                next_reminder = now + REMINDER_SECONDS
            time.sleep(0.25)
    except KeyboardInterrupt:
        return 130
    except ValueError as exc:
        print(f"[heavy] {exc}", file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"[heavy] {exc}", file=sys.stderr)
        return 127 if isinstance(exc, FileNotFoundError) else 126
    finally:
        for handle in handles:
            handle.close()


if __name__ == "__main__":
    raise SystemExit(main())
